{
  "obsidian": 1,
  "id": "alomare.unleashedcamera",
  "version": "0.8.1",
  "name": {
    "en": "Unleashed Camera"
  },
  "description": {
    "en": "Third person and first person cameras that keep other mods working."
  },
  "authors": [
    "Alomare",
    "yukiorsrs"
  ],
  "source": "https://github.com/Alomare/HD1-UnleashedCamera",
  "scope": "session",
  "parts": [
    {
      "id": "view",
      "scope": "client",
      "name": { "en": "Camera and view" },
      "description": { "en": "Camera, aim, view distance, sky and enemy indicators. Keeps working in any lobby." }
    },
    {
      "id": "weapon_range",
      "scope": "session",
      "option": "max_weapon_range",
      "name": { "en": "Max weapon range" },
      "description": { "en": "Every weapon reaches as far as the farthest one. Off in lobbies with players who don't run it." }
    },
    {
      "id": "enemy_detection",
      "scope": "session",
      "option": "far_detection",
      "name": { "en": "Far enemy detection" },
      "description": { "en": "Enemies notice and chase the squad from much farther away. Off in lobbies with players who don't run it." }
    },
    {
      "id": "free_movement",
      "scope": "session",
      "option": "free_movement",
      "name": { "en": "Free movement" },
      "description": { "en": "In third person, the Helldiver can leave the shared top-down screen. Off in lobbies with players who don't run it." }
    },
    {
      "id": "throw_range",
      "scope": "session",
      "option": "throw_range",
      "name": { "en": "Increased throw range" },
      "description": { "en": "Grenades and stratagem balls fly twice as far. Off in lobbies with players who don't run it." }
    }
  ],
  "entry": "main.lua",
  "modules": [
    "src/config.lua",
    "src/scoped.lua",
    "src/rig.lua",
    "src/pod.lua",
    "src/shake.lua",
    "src/frustum.lua",
    "src/camera.lua",
    "src/aim.lua",
    "src/crosshair.lua",
    "src/view.lua",
    "src/radar.lua",
    "src/hits.lua",
    "src/look.lua",
    "src/session.lua"
  ],
  "requires": [
    "obsidian.api"
  ],
  "loader_api": 1,
  "option_groups": [
    { "id": "camera", "label": { "en": "Camera" } },
    { "id": "third", "label": { "en": "Third person" } },
    { "id": "first", "label": { "en": "First person" } },
    { "id": "vehicles", "label": { "en": "Vehicles" } },
    { "id": "indicators", "label": { "en": "Indicators and names" } },
    { "id": "picture", "label": { "en": "Picture" } },
    { "id": "lobby", "label": { "en": "Session features" } }
  ],
  "options": [
    { "id": "camera_mode", "type": "choice", "default": "third",
      "choices": [ { "id": "default", "label": { "en": "Default" } }, { "id": "third", "label": { "en": "Third person" } }, { "id": "first", "label": { "en": "First person" } } ],
      "group": "camera", "part": "view", "scope": "client",
      "label": { "en": "Camera mode" },
      "description": { "en": "The camera at the start of the game. Default is the top-down camera of the game. The camera key cycles the three in a mission. In first person the camera sits in the head of the Helldiver and the helmet is hidden; vehicles keep the third-person camera." } },
    { "id": "look_speed", "type": "number", "default": 1, "min": 0.1, "max": 3, "step": 0.05,
      "group": "camera", "part": "view", "scope": "client",
      "label": { "en": "Look sensitivity" },
      "description": { "en": "How fast the camera turns with the mouse or the right stick." } },
    { "id": "invert_y", "type": "toggle", "default": false,
      "group": "camera", "part": "view", "scope": "client",
      "label": { "en": "Invert vertical look" },
      "description": { "en": "Moving the mouse up looks down." } },
    { "id": "camera_shake", "type": "choice", "default": "medium",
      "choices": [ { "id": "off", "label": { "en": "Off" } }, { "id": "weak", "label": { "en": "Weak" } }, { "id": "medium", "label": { "en": "Medium" } }, { "id": "strong", "label": { "en": "Strong" } } ],
      "group": "camera", "part": "view", "scope": "client",
      "label": { "en": "Camera shake" },
      "description": { "en": "How much explosions, impacts and the Hellpod landing shake the shoulder camera." } },
    { "id": "hellpod_camera", "type": "toggle", "default": true,
      "group": "camera", "part": "view", "scope": "client",
      "label": { "en": "Hellpod camera" },
      "description": { "en": "When the Helldiver drops in, the camera rides down above the Hellpod looking down on it, shakes on the landing, and glides into the shoulder view once the Helldiver climbs out. The view stays still until then." } },
    { "id": "shoulder", "type": "choice", "default": "right",
      "choices": [ { "id": "right", "label": { "en": "Right" } }, { "id": "left", "label": { "en": "Left" } } ],
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Shoulder" },
      "description": { "en": "The side of the Helldiver the camera sits on. The swap key changes it in a mission. A mech camera starts on the same side; in any vehicle the swap key moves the camera from left to the middle to right." } },
    { "id": "foot_distance", "type": "number", "default": 3, "min": 1, "max": 10, "step": 0.5,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Distance on foot (m)" },
      "description": { "en": "Meters between the camera and the Helldiver on foot in a mission." } },
    { "id": "foot_fov", "type": "number", "default": 70, "min": 40, "max": 110, "step": 1,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Field of view on foot (degrees)" },
      "description": { "en": "Vertical field of view on foot in third person." } },
    { "id": "camera_height", "type": "number", "default": 0, "min": -1, "max": 1.5, "step": 0.1,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Overall camera height (m)" },
      "description": { "en": "Raises or lowers the third-person camera on foot, in a dive, while down, in vehicles and on the Super Destroyer." } },
    { "id": "ship_distance", "type": "number", "default": 2, "min": 0.5, "max": 10, "step": 0.5,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Distance on the Super Destroyer (m)" },
      "description": { "en": "Meters between the camera and the Helldiver on the Super Destroyer." } },
    { "id": "dive_camera", "type": "toggle", "default": true,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Dive camera" },
      "description": { "en": "Brings the camera down during a dive, quickly but smoothly, and eases it back up once the dive ends." } },
    { "id": "downed_camera", "type": "toggle", "default": true,
      "group": "third", "part": "view", "scope": "client",
      "label": { "en": "Downed camera" },
      "description": { "en": "While the Helldiver is down and crawling, the camera sits as low as in a dive, and 1 m farther back." } },
    { "id": "first_person_fov", "type": "number", "default": 80, "min": 50, "max": 120, "step": 1,
      "group": "first", "part": "view", "scope": "client",
      "label": { "en": "Field of view (degrees)" },
      "description": { "en": "Vertical field of view in first person." } },
    { "id": "first_person_height", "type": "number", "default": 0.14, "min": -0.3, "max": 0.6, "step": 0.01,
      "group": "first", "part": "view", "scope": "client",
      "label": { "en": "Eye height (m)" },
      "description": { "en": "Metres the camera sits above the middle of the head." } },
    { "id": "first_person_forward", "type": "number", "default": 0.22, "min": -0.2, "max": 0.8, "step": 0.01,
      "group": "first", "part": "view", "scope": "client",
      "label": { "en": "Eye forward (m)" },
      "description": { "en": "Metres the camera sits in front of the head, along the ground. Looking down adds up to 0.3 m more, so the inside of the body stays out of view." } },
    { "id": "first_person_side", "type": "number", "default": 0, "min": -0.5, "max": 0.5, "step": 0.01,
      "group": "first", "part": "view", "scope": "client",
      "label": { "en": "Eye side (m)" },
      "description": { "en": "Metres the camera sits to the right of the head; below 0, to the left." } },
    { "id": "vehicle_distance", "type": "number", "default": 7, "min": 3, "max": 20, "step": 0.5,
      "group": "vehicles", "part": "view", "scope": "client",
      "label": { "en": "Distance (m)" },
      "description": { "en": "Meters between the camera and the vehicle: mech, APC, bike and turrets. A mech camera sits beside the shoulder, other vehicles in the middle and high." } },
    { "id": "vehicle_fov", "type": "number", "default": 70, "min": 40, "max": 120, "step": 1,
      "group": "vehicles", "part": "view", "scope": "client",
      "label": { "en": "Field of view (degrees)" },
      "description": { "en": "Vertical field of view in a vehicle." } },
    { "id": "radar", "type": "toggle", "default": true,
      "group": "indicators", "part": "view", "scope": "client",
      "label": { "en": "Enemy indicators" },
      "description": { "en": "A ring around the crosshair in four segments. The right, back and left segments show faintly while an enemy is in range on that side, and stronger within half the range. The side with the closest enemy within half the range also shows a warning triangle. Hidden while the game is paused." } },
    { "id": "radar_range", "type": "number", "default": 15, "min": 5, "max": 40, "step": 2.5,
      "group": "indicators", "part": "view", "scope": "client", "visible_when": {"radar": true},
      "label": { "en": "Indicator range (m)" },
      "description": { "en": "Enemies closer than this show on the ring; within half of it, the segment is stronger." } },
    { "id": "hit_indicators", "type": "toggle", "default": true,
      "group": "indicators", "part": "view", "scope": "client",
      "label": { "en": "Hit direction" },
      "description": { "en": "A bar near the crosshair points toward where a hit came from and fades within 2 seconds: red when health is lost, yellow when the personal shield takes it, white when the vehicle does. A bar for an enemy follows the enemy." } },
    { "id": "names_above", "type": "toggle", "default": true,
      "group": "indicators", "part": "view", "scope": "client",
      "label": { "en": "Names above heads" },
      "description": { "en": "In third person, the name cards of players show above their heads instead of at their feet." } },
    { "id": "no_fog", "type": "toggle", "default": true,
      "group": "picture", "part": "view", "scope": "client",
      "label": { "en": "Remove fog" },
      "description": { "en": "Removes the fog of the level, in third person and in the top-down view. Photo Mode shows the fog while it is open." } },
    { "id": "depth_of_field", "type": "choice", "default": "off",
      "choices": [ { "id": "game", "label": { "en": "Game default" } }, { "id": "helldiver", "label": { "en": "Focus on the Helldiver" } }, { "id": "off", "label": { "en": "Off" } } ],
      "group": "picture", "part": "view", "scope": "client",
      "label": { "en": "Depth of field" },
      "description": { "en": "Game default keeps the blur of the planet. Focus on the Helldiver keeps the Helldiver sharp and blurs what lies a metre or more nearer or farther; in first person the sharp part is where the crosshair points. Off keeps the whole picture sharp. Photo Mode sets the depth of field while open." } },
    { "id": "far_view", "type": "toggle", "default": true,
      "group": "picture", "part": "view", "scope": "client",
      "label": { "en": "Long view distance" },
      "description": { "en": "Pushes the fog, the far edge of the view and the detail of distant models out, so distant enemies and landmarks show." } },
    { "id": "fix_sky", "type": "toggle", "default": true,
      "group": "picture", "part": "view", "scope": "client",
      "label": { "en": "Sky" },
      "description": { "en": "Draws a sky over the level in the color of the planet fog, instead of the smears the game leaves past the level. Needs a deploy." } },
    { "id": "max_weapon_range", "type": "toggle", "default": true,
      "group": "lobby", "part": "weapon_range",
      "label": { "en": "Max weapon range" },
      "description": { "en": "Every weapon reaches as far as the farthest one, so targets far off in the third-person view can be hit. Changes the shared game: off in lobbies with players who don't run it." } },
    { "id": "far_detection", "type": "toggle", "default": true,
      "group": "lobby", "part": "enemy_detection",
      "label": { "en": "Far enemy detection" },
      "description": { "en": "Enemies notice and chase the squad from much farther away. Alarm range stays as in the game. Changes the shared game: off in lobbies with players who don't run it." } },
    { "id": "free_movement", "type": "toggle", "default": true,
      "group": "lobby", "part": "free_movement",
      "label": { "en": "Free movement" },
      "description": { "en": "In third person, the Helldiver is no longer held on the shared top-down screen with the squad. Changes the shared game: off in lobbies with players who don't run it." } },
    { "id": "throw_range", "type": "toggle", "default": true,
      "group": "lobby", "part": "throw_range",
      "label": { "en": "Increased throw range" },
      "description": { "en": "Grenades and stratagem balls fly twice as far, on top of the Strong Arm perk. Changes the shared game: off in lobbies with players who don't run it." } }
  ],
  "keybinds": [
    { "id": "toggle_view", "default": "f8", "label": { "en": "Cycle the camera: top-down, third person, first person" } },
    { "id": "swap_shoulder", "default": "h", "label": { "en": "Swap the camera shoulder (in a vehicle: left, middle, right)" } }
  ],
  "resources": [
    { "type": "render_config", "name": "#1a9c33dcd0301dfd", "bundle": "1a9c33dcd0301dfd", "data": "res/render_config.bin", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/desert_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_desert.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/desert", "bundle": "9cf71054ea26dddf", "data": "res/sky_desert.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/desert", "bundle": "9cf71054ea26dddf", "data": "res/sky_desert.unit", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/forest_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_forest.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/forest", "bundle": "9cf71054ea26dddf", "data": "res/sky_forest.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/forest", "bundle": "9cf71054ea26dddf", "data": "res/sky_forest.unit", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/snow_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_snow.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/snow", "bundle": "9cf71054ea26dddf", "data": "res/sky_snow.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/snow", "bundle": "9cf71054ea26dddf", "data": "res/sky_snow.unit", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/lava_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_lava.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/lava", "bundle": "9cf71054ea26dddf", "data": "res/sky_lava.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/lava", "bundle": "9cf71054ea26dddf", "data": "res/sky_lava.unit", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/city_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_city.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/city", "bundle": "9cf71054ea26dddf", "data": "res/sky_city.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/city", "bundle": "9cf71054ea26dddf", "data": "res/sky_city.unit", "part": "view", "when": { "fix_sky": true } },
    { "type": "texture", "name": "itp/sky/night_map", "bundle": "9cf71054ea26dddf", "data": "res/sky_night.texture", "part": "view", "when": { "fix_sky": true } },
    { "type": "material", "name": "itp/sky/night", "bundle": "9cf71054ea26dddf", "data": "res/sky_night.material", "part": "view", "when": { "fix_sky": true } },
    { "type": "unit", "name": "itp/sky/night", "bundle": "9cf71054ea26dddf", "data": "res/sky_night.unit", "part": "view", "when": { "fix_sky": true } }
  ]
}
